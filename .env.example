# --- IA ---------------------------------------------------------------------
OPENAI_API_KEY=replace_with_your_key
OPENAI_MODEL=gpt-5.6-luna

# --- Slack (facultatif) -----------------------------------------------------
SLACK_BOT_TOKEN=xoxb-replace_with_your_bot_token

# --- Authentification Supabase ----------------------------------------------
# Clés publiques : embarquées dans le bundle navigateur et lues par l'API locale.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Administration des comptes — NE JAMAIS préfixer VITE_.
# En local, ajoute-les dans .env.local ; en production, dans les variables Vercel.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
